# Admin password for the /admin area (required).
# The /admin area is disabled until this is set to a strong, non-default
# password (do not leave it as "admin").
ADMIN_PASSWORD=admin

# Optional: secret used to sign the admin session cookie.
# If unset, falls back to ADMIN_PASSWORD.
SESSION_SECRET=change-me-to-a-random-string

# Optional: override the SQLite database file path.
# SQLITE_PATH=/tmp/soba.db

# Optional: PostgreSQL connection string. When set, the app uses PostgreSQL
# (via the `pg` driver) instead of SQLite. Required for production/Vercel
# persistence. Example: postgres://user:pass@host:5432/db
# DATABASE_URL=

# Optional: force TLS for PostgreSQL connections. Set to "true" for providers
# that require SSL (e.g. Supabase/Neon). Also auto-enabled when the
# DATABASE_URL query string contains `sslmode=require`.
# DATABASE_SSL=
